{
  "taskir_version": "0.1",
  "meta": {
    "name": "find_cheapest_flight_verified",
    "provenance": {"source": "handwritten", "author": "phase1-toy"}
  },
  "program": {
    "name": "find_cheapest_flight_verified",
    "description": "Find the cheapest flight arriving before 8 PM, explain it, and verify the answer before returning",
    "inputs": [{"name": "@task", "type": "Str"}],
    "nodes": [
      {
        "id": "%1",
        "op": "SEARCH",
        "inputs": ["@task"],
        "params": {"domain": "flight"},
        "output_type": "List[Flight]",
        "hints": {"resource_class": "api"}
      },
      {
        "id": "%2",
        "op": "FILTER",
        "inputs": ["%1"],
        "params": {"predicate": "arrive_time < '20:00'"},
        "output_type": "List[Flight]"
      },
      {
        "id": "%3",
        "op": "ARGMIN",
        "inputs": ["%2"],
        "params": {"key": "price"},
        "output_type": "Flight"
      },
      {
        "id": "%4",
        "op": "GENERATE",
        "inputs": ["%3", "@task"],
        "params": {"role": "final_answer"},
        "retry": {"max_attempts": 3, "on": "%5"},
        "hints": {"model_class": "small"}
      },
      {
        "id": "%5",
        "op": "VERIFY",
        "inputs": ["%4", "%3"],
        "params": {"check": "answer_grounded_in_tool_results"}
      }
    ],
    "output": "%4"
  }
}
